{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"], "strict": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true, "esModuleInterop": true,
    "rootDir": ".", "outDir": "dist", "sourceMap": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "activity/src/**/*.ts", "tests/**/*.ts"]
}
