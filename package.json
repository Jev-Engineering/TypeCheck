{
  "name": "typecheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build": "tsc && node scripts/bundle-sdk.mjs",
    "test": "tsc && node --test --test-concurrency=1 dist/tests/*.test.js",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "migrate": "node --env-file-if-exists=.env dist/server/migrate.js",
    "preview": "node scripts/preview.mjs",
    "evaluate": "node --env-file-if-exists=.env dist/server/evaluate-cli.js",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:compose": "node scripts/test-compose.mjs",
    "test:mysql": "node scripts/test-mysql.mjs",
    "evaluate:content": "node --env-file-if-exists=.env dist/server/content-evaluate-cli.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "mysql2": "3.24.6",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "typescript": "5.9.3"
  },
  "main": "dist/server/main.js"
}
